{
  "name": "create-ts-setup",
  "version": "0.0.1",
  "description": "Interactive CLI to scaffold a barebones custom TypeScript setup",
  "type": "module",
  "bin": {
    "create-ts-setup": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test:scaffold": "tsx scripts/verify-scaffold.ts",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "typescript",
    "scaffold",
    "cli",
    "create"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b"
}
